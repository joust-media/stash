{
  "name": "coinquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --no-warnings=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "seed": "tsx --no-warnings=ExperimentalWarning server/seed.ts",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "start": "NODE_ENV=production tsx --no-warnings server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.62.7",
    "hono": "^4.6.14",
    "mysql2": "^3.23.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
